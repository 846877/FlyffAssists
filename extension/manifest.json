{
  "manifest_version": 3,
  "name": "FlyffAssist",
  "version": "0.2.0",
  "description": "Assistant de soutien pour Flyff Universe : suivi, buffs et soin automatique du perso principal.",
  "content_scripts": [
    {
      "world": "MAIN",
      "js": ["flyffassist.js"],
      "matches": ["*://universe.flyff.com/*"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
